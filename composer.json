{
    "name": "rumbleh/laravel-ciot-antt",
    "description": "Cliente Laravel para emissão de CIOT junto ao web service PEF da ANTT (Pagamento Eletrônico de Frete).",
    "keywords": ["laravel", "ciot", "antt", "pef", "frete", "transporte", "rntrc"],
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2 || ^8.3 || ^8.4",
        "ext-json": "*",
        "ext-openssl": "*",
        "guzzlehttp/guzzle": "^7.8",
        "illuminate/support": "^11.0 || ^12.0",
        "illuminate/contracts": "^11.0 || ^12.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "orchestra/testbench": "^9.0 || ^10.0",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "Rumbleh\\CiotAntt\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rumbleh\\CiotAntt\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Rumbleh\\CiotAntt\\CiotServiceProvider"
            ],
            "aliases": {
                "Ciot": "Rumbleh\\CiotAntt\\Facades\\Ciot"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test:coverage": "vendor/bin/phpunit --coverage-text"
    },
    "config": {
        "sort-packages": true,
        "preferred-install": "dist"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
